--- 
//Estas lineas son algo de astros, se llama Frontmatter, y sirve para ejecutar algo solo cuando se carga la pagina,
---

<html>
  <head>
    <title>Armario Virtual</title>
  </head>
  <body>
    <div class="container">
      
      <nav class="sidebar"> <!-- //la barra del costado para poder abrir las secciones-->
        <h2>Armario</h2>
        <ul>
          <li onclick="mostrarSeccion('ropa')">Mi Ropa</li>
          <li onclick="mostrarSeccion('calendario')">Calendario</li>
          <li onclick="mostrarSeccion('clima')">Clima</li>
          <hr style="border: 0.5px solid #333333; margin: 20px 0;">    <!--La linea del costado para separar  -->
          <li onclick="toggleDarkMode()" id="btnTema">Modo Oscuro</li>
        </ul>
      </nav>

      <main class="content">
<!-- SECCION ROPA -->
        <div id="seccionRopa" class="seccion">
          <h1>Mi Ropa</h1>
          <section class="seccion-carga">
            <h2>Agregar Nueva Prenda</h2>
            <div class="form-group">
              <input id="nombreInput" type="text" placeholder="Ej: Buzo de lana">
              <select id="tipoInput">
                <option value="" disabled selected>Elegi tipo</option>
                <option value="remera">Remera</option>
                <option value="pantalon">Pantalon</option>
                <option value="buzo">Buzo</option>
              </select>
              <select id="estacionInput">
                <option value="" disabled selected>Elegi estacion</option>
                <option value="verano">Verano</option>
                <option value="invierno">Invierno</option>
                <option value="medio tiempo">Medio Tiempo</option>
              </select>
              <button onclick="agregarRopa()">Agregar al Armario</button>
            </div>
          </section>

          <section class="seccion-filtros">
            <h2>Buscar</h2>
            <div class="filtros-container">
              <input type="text" id="buscadorInput" placeholder="Buscar por nombre" oninput="filtrarRopa()">
              <select id="filtroTipo" onchange="filtrarRopa()">
                <option value="todos">Todos los tipos</option>
                <option value="remera">Remeras</option>
                <option value="pantalon">Pantalones</option>
                <option value="buzo">Buzos</option>
              </select>
              <select id="filtroEstacion" onchange="filtrarRopa()">
                <option value="todos">Todas las estaciones</option>
                <option value="verano">Verano</option>
                <option value="invierno">Invierno</option>
                <option value="medio tiempo">Medio Tiempo</option>
              </select>
            </div>
          </section>

          <div id="ropaContainer" class="ropa-container">
            </div>
        </div>
<!-- SECCION CALENDARIO -->
        <div id="seccionCalendario" class="seccion" style="display: none;">
          <h1>Calendario de Outfits</h1>
          <p>Selecciona un dia para sumar prendas (Marzo 2026)</p>
          <div id="calendarioGrid" class="calendario-grid"></div>
          <div id="formCalendario" class="seccion-carga" style="margin-top: 15px; display: none;">
            <h3 id="diaSeleccionadoTitulo">Dia seleccionado</h3>
            <div class="form-group">
              <select id="selectRopaCalendario"></select>
              <button onclick="guardarOutfitDia()">Sumar Prenda</button>
              <button onclick="borrarOutfitDia()" style="background: #ff4d4d;">Limpiar Dia</button>
            </div>
          </div>
        </div>
<!-- SECCION CLIMA -->
        <div id="seccionClima" class="seccion" style="display: none;">
          <h1>Clima</h1>
          <div class="seccion-carga">
            <input type="text" id="ciudadInput" placeholder="Escribi una ciudad">
            <button onclick="buscarClima()">Buscar Clima</button>
          </div>
          <div id="climaInfo" class="clima-card">
            <p>Ingresa una ciudad para ver el clima</p>
          </div>
        </div>

      </main>
    </div>
  </body>
</html>

<!-- DISEÑO -->
<style is:global> 
/* De todo */
  :root {
    --bg-body: #f4f4f9;
    --bg-cards: #ffffff;
    --text-main: #333333;
    --border-color: #dddddd;
    --accent: #a04dff;
  }

  .dark-mode {
    --bg-body: #121212;
    --bg-cards: #1e1e1e;
    --text-main: #e0e0e0;
    --border-color: #333333;
    --accent: #681e8a;
  }

  body { margin: 0; font-family: Verdana ; background-color: var(--bg-body); color: var(--text-main); transition: 0.3s; }
  .container { display: flex; height: 100vh; }
  .sidebar { width: 220px; background: #271a2e; color: white; padding: 30px 20px; flex-shrink: 0; }
  .sidebar ul { list-style: none; padding: 0; }
  .sidebar li { padding: 12px 15px; margin-bottom: 10px; border-radius: 8px; cursor: pointer; }
  .sidebar li:hover { background: #5c1b70; }
  
  .content { flex: 1; padding: 20px 40px; overflow-y: auto; }
  .seccion-carga, .seccion-filtros, .clima-card, .card, .dia { 
    background: var(--bg-cards); 
    border: 1px solid var(--border-color);
    padding: 15px; border-radius: 12px; margin-bottom: 15px; 
  }
  input, select, button, h1, h2, h3 {
    font-family: inherit;}

  .form-group { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  input, select { padding: 8px; border: 1px solid var(--border-color); border-radius: 6px; background: var(--bg-cards); color: var(--text-main); }
  button { padding: 8px 15px; background: #a04dff; border: none; color: white; border-radius: 6px; cursor: pointer; font-weight: bold; }

  .ropa-container { display: flex; gap: 15px; flex-wrap: wrap; }
  .card { width: 160px; border-top: 5px solid #a04dff; }

  /* ESTILOS CALENDARIO BLOQUES */
  .calendario-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; max-width: 800px; }
  .dia { min-height: 90px; padding: 5px; cursor: pointer; display: flex; flex-direction: column; }
  .dia.seleccionado { border: 2px solid #a04dff; }
  .dia-numero { font-weight: bold; font-size: 0.9rem; }
  
  .contenedor-prendas-calendario { display: flex; flex-direction: column; gap: 3px; margin-top: 5px; }
  .prenda-tag-calendario { 
    background-color: #a04dff; color: white; font-size: 0.65rem; 
    padding: 2px 5px; border-radius: 4px; white-space: nowrap; 
    overflow: hidden; text-overflow: ellipsis; 
  }
  .dark-mode .prenda-tag-calendario { background-color: #681e8a; }
</style>

<!-- SCRIPT -->
<script is:inline> 
  let diaSeleccionadoGlobal = null;

  function mostrarSeccion(id) { //esta funcion sirve para mostrar las diferentes secciones
    document.querySelectorAll('.seccion').forEach(s => s.style.display = 'none');
    const target = document.getElementById('seccion' + id.charAt(0).toUpperCase() + id.slice(1));
    if (target) target.style.display = 'block';
    if (id === 'calendario') generarCalendario();
  }

  // De la seccion "Mi Ropa"
  ///La funcion cargarRopa sirve para tener prendas que ya te vengan previas antes de usar el armario
  const ropaInicial = [
    { nombre: "Camiseta de Argentina", etiquetas: "remera, verano" },
    { nombre: "Jean Azul", etiquetas: "pantalon, medio tiempo" },
    { nombre: "Buzo Verde", etiquetas: "buzo, invierno" }
  ];

  function mostrarSeccion(id) {
    document.querySelectorAll('.seccion').forEach(s => s.style.display = 'none');
    const target = document.getElementById('seccion' + id.charAt(0).toUpperCase() + id.slice(1));
    if (target) target.style.display = 'block';
    if (id === 'calendario') generarCalendario();
  }

  // --- SECCION ROPA ---
//funcion para cargar la ropa que tenga guardada y las prerndasd iniciales
  function cargarRopa() {
    const ropaGuardada = JSON.parse(localStorage.getItem("misPrendas")) || [];
    const todasLasPrendas = [...ropaInicial, ...ropaGuardada];
    const c = document.getElementById("ropaContainer");
    if (c) {
      c.innerHTML = ""; 
      todasLasPrendas.forEach(p => crearCard(p.nombre, p.etiquetas));
    }
  }

//funcion para agregar ropa nueva
  function agregarRopa() {
    const n = document.getElementById("nombreInput").value;
    const t = document.getElementById("tipoInput").value;
    const e = document.getElementById("estacionInput").value;
    if (!n || !t || !e) return;
    const ets = `${t}, ${e}`;
    const g = JSON.parse(localStorage.getItem("misPrendas")) || [];
    g.push({ nombre: n, etiquetas: ets });
    localStorage.setItem("misPrendas", JSON.stringify(g));
    cargarRopa();
    document.getElementById("nombreInput").value = "";
  }
  //apartir de ropa agregada la crea en el html
  function crearCard(n, e) {
    const c = document.getElementById("ropaContainer");
    const d = document.createElement("div");
    d.classList.add("card");
    d.innerHTML = `<h3>${n}</h3><p>${e}</p>`;
    c.appendChild(d);
  }

 //para el buscador 
  function filtrarRopa() {
    const busqueda = document.getElementById("buscadorInput").value.toLowerCase();
    const filtroTipo = document.getElementById("filtroTipo").value.toLowerCase();
    const filtroEstacion = document.getElementById("filtroEstacion").value.toLowerCase();

    document.querySelectorAll(".card").forEach(card => {
      const nombrePrenda = card.querySelector("h3").innerText.toLowerCase();
      const etiquetasPrenda = card.querySelector("p").innerText.toLowerCase();

      const coincideNombre = nombrePrenda.includes(busqueda);
      const coincideTipo = filtroTipo === "todos" || etiquetasPrenda.includes(filtroTipo);
      const coincideEstacion = filtroEstacion === "todos" || etiquetasPrenda.includes(filtroEstacion);

      if (coincideNombre && coincideTipo && coincideEstacion) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  }
  // CALENDARIO

  //funcion que crea la grirlla del calendario
  function generarCalendario() {
    const grid = document.getElementById("calendarioGrid");
    grid.innerHTML = "";
    const outfits = JSON.parse(localStorage.getItem("outfitsCalendario")) || {};
    
    for (let i = 1; i <= 30; i++) {
      const div = document.createElement("div");
      div.classList.add("dia");
      if (diaSeleccionadoGlobal === i) div.classList.add("seleccionado");

      let htmlPrendas = "";
      if (outfits[i] && Array.isArray(outfits[i])) {
        htmlPrendas = outfits[i].map(p => `<div class="prenda-tag-calendario">${p}</div>`).join("");
      }

      div.innerHTML = `
        <span class="dia-numero">${i}</span>
        <div class="contenedor-prendas-calendario">${htmlPrendas}</div>
      `;
      
      div.onclick = () => {
        diaSeleccionadoGlobal = i;
        generarCalendario();
        abrirFormCalendario(i);
      };
      grid.appendChild(div);
    }
  }

  //las siguientes dos funciones son las que se ocupan de poder agregar prendas al calendario
  function abrirFormCalendario(dia) {
    const form = document.getElementById("formCalendario");
    const select = document.getElementById("selectRopaCalendario");
    
    // 1. Buscamos la ropa guardada
    const ropaGuardada = JSON.parse(localStorage.getItem("misPrendas")) || [];
    // 2. La juntamos con la ropaInicial
    const todaLaRopa = [...ropaInicial, ...ropaGuardada]; 
    
    form.style.display = "block";
    document.getElementById("diaSeleccionadoTitulo").innerText = "Ropa para el dia " + dia;
    select.innerHTML = '<option value="">Sumar prenda...</option>';
    
    // 3. Llenamos el select con la lista completa
    todaLaRopa.forEach(p => {
      const opt = document.createElement("option");
      opt.value = p.nombre; 
      opt.innerText = p.nombre;
      select.appendChild(opt);
    });
  }

  function guardarOutfitDia() {
    const prenda = document.getElementById("selectRopaCalendario").value;
    if (!prenda || !diaSeleccionadoGlobal) return;
    let outfits = JSON.parse(localStorage.getItem("outfitsCalendario")) || {};
    if (!outfits[diaSeleccionadoGlobal]) outfits[diaSeleccionadoGlobal] = [];
    if (!outfits[diaSeleccionadoGlobal].includes(prenda)) outfits[diaSeleccionadoGlobal].push(prenda);
    localStorage.setItem("outfitsCalendario", JSON.stringify(outfits));
    generarCalendario();
  }

  //para borrar outfits
  function borrarOutfitDia() {
    let outfits = JSON.parse(localStorage.getItem("outfitsCalendario")) || {};
    delete outfits[diaSeleccionadoGlobal];
    localStorage.setItem("outfitsCalendario", JSON.stringify(outfits));
    generarCalendario();
  }

  // CLIMA
  //Funcion que apartir de la api del clima te pone el clima de la ciudad
  async function buscarClima() {
    const ciudad = document.getElementById("ciudadInput").value || "Buenos Aires";
    const API_KEY = "1f3703743e3789315f4aa641551fff22";
    const contenedor = document.getElementById("climaInfo");
    try {
      const res = await fetch(`https://api.openweathermap.org/data/2.5/weather?q=${ciudad}&appid=${API_KEY}&units=metric&lang=es`);
      const data = await res.json();
      contenedor.innerHTML = `<h3>${data.name}</h3><p class="temp">${Math.round(data.main.temp)}°C</p><p>${data.weather[0].description}</p>`;
    } catch { contenedor.innerHTML = "<p>Error al cargar clima</p>"; }
  }

//Modo oscuro

  function toggleDarkMode() {
    const isDark = document.body.classList.toggle("dark-mode");
    localStorage.setItem("tema", isDark ? "dark" : "light");
    document.getElementById("btnTema").innerText = isDark ? "Modo Claro" : "Modo Oscuro";
  }


  // Carga inicial
  window.onload = () => {
    cargarRopa();
    if (localStorage.getItem("tema") === "dark") toggleDarkMode();
  };
</script>